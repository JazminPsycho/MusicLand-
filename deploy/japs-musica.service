[Unit]
Description=JAPs Música — colección local
After=network.target
[Service]
Type=simple
User=japs-musica
Group=japs-musica
WorkingDirectory=/opt/japs-musica
ExecStart=/opt/japs-musica/start.sh --data /var/lib/japs-musica --host 0.0.0.0 --port 8765
Restart=on-failure
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/japs-musica
MemoryMax=512M
TasksMax=32
[Install]
WantedBy=multi-user.target
